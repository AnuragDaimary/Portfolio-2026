# ---- Database ----------------------------------------------------------
# Pooled connection used by the app at runtime (Neon/Supabase give you this).
DATABASE_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"
# Direct (unpooled) connection, used only by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"

# ---- Email (Resend) ----------------------------------------------------
RESEND_API_KEY=""
# Must be a verified sending domain in Resend.
CONTACT_FROM_EMAIL="portfolio@yourdomain.com"
# Where contact-form submissions get delivered.
CONTACT_TO_EMAIL="anurag.daimary1@gmail.com"

# ---- Security ----------------------------------------------------------
# Random 32+ char string. Used to hash visitor IPs so we never store raw ones.
IP_HASH_SALT=""

# ---- App ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
